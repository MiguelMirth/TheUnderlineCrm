# The Underline automation — environment contract
# Copy to .env and fill secrets. Never commit .env.
# Defaults below match code as of 2026-09-01. CLIs may override at runtime.

# --- APIs ---
APOLLO_API_KEY=
MONDAY_API_KEY=
TAVILY_API_KEY=
CURSOR_API_KEY=
GEMINI_API_KEY=

# --- Monday ---
# The engine Preset screen overrides these two for prospecting runs after you save.
# Email, triage, and cleanup still read the values here.
MASTER_BOARD_ID=18401545002
NEW_LEADS_GROUP_ID=group_mm0xbmrj
ACTIVE_OUTREACH_GROUP_ID=group_mm0x18c
# Current production GraphQL version (2026-09). 2026-10 / 2027-01 are RCs — not for prod.
MONDAY_API_VERSION=2026-07

TRIAGE_GROUP_NEW_LEADS=group_mm0xbmrj
TRIAGE_GROUP_ACTIVE=group_mm0x18c
TRIAGE_GROUP_ENGAGED=group_mm0xj5rd
TRIAGE_GROUP_MEETING=group_mm0xj1qw
TRIAGE_GROUP_DISQUALIFIED=group_mm0xtvgg

# --- Prospecting engine (src/engine, web/) ---
# SQLite file for runs, leads, API cache, and the spend ledger. Relative paths start at the repo root.
ENGINE_DB_PATH=data/engine/underline.db
# Fallback allowances when a live balance cannot be read.
# Apollo and Tavily remaining credits are read from their APIs. Cursor counts runs until the 13th.
# Gemini has no balance. A blank Gemini ceiling does not block a run.
APOLLO_MONTHLY_CREDIT_CEILING=
TAVILY_MONTHLY_CREDIT_CEILING=
CURSOR_MONTHLY_RUN_CEILING=
GEMINI_MONTHLY_REQUEST_CEILING=
# Hard cap on Tavily searches in one run (spend evidence and research).
RUN_MAX_TAVILY_QUERIES=25
# Live Monday create from the engine. Leave false. The push dialog also requires an explicit live confirmation.
ENGINE_LIVE_PUSH_ENABLED=false
# Hours before the Monday board snapshot is stale. Start refreshes it when stale; Refresh board refreshes it now.
CRM_SNAPSHOT_TTL_HOURS=12
# Days a cached Apollo, Tavily, Cursor, or Gemini payload stays free to reuse.
API_CACHE_TTL_DAYS=30
# Concert and Venue QA. Verified October 2026: gemini-3.8-flash, structured JSON, thinking level low.
# Triage stays on GEMINI_TRIAGE_MODEL. The QA payload is brand, industry, title, person state, and evidence only.
GEMINI_QA_MODEL=gemini-3.8-flash
# Used when the primary model answers 429, 500, or 503. A failed call is not cached and is not shortlisted.
GEMINI_QA_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_QA_BATCH_SIZE=20
# Port for the serve command. The process binds to 127.0.0.1 only.
ENGINE_PORT=8765
# Named Cloudflare Access, once a domain is on the Cloudflare account. A quick tunnel does not use these.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Gmail (Frenchy mailbox; files are gitignored) ---
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json
GMAIL_REPLIES_LABEL=REPLIES
GEMINI_TRIAGE_MODEL=gemini-2.5-flash-lite
TRIAGE_SKIP_SENDERS=lia@knowyourmirth.com

# --- Sends ---
DRY_RUN=true
MAX_SENDS=0
UNDERLINE_DECK_LINK=
FOLLOWUP_DATE_FROM=2026-03-25
FOLLOWUP_DATE_TO=2026-06-01
FOLLOWUP_CANDIDATES_FILE=data/outputs/followup_candidates.json

# --- Slack DMs to Lia (after live email / Monday push) ---
# SLACK_USER_TOKEN=xoxp-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_LIA_USER_ID=
SLACK_LIA_EMAIL=lia@knowyourmirth.com
SLACK_NOTIFY=true

# --- Prospecting (module defaults; the engine passes per-run toggles instead) ---
PROSPECT_REQUIRE_US=true
PROSPECT_REQUIRE_FLORIDA=true
PROSPECT_PERSON_FLORIDA_ONLY=true
PROSPECT_ALLOW_GLOBAL_ORG=true
PROSPECT_BRAND_MODE=true
PROSPECT_SPONSOR_STRICT=true
PROSPECT_MIN_CONFIDENCE=80
PROSPECT_MIN_CONTACT_SCORE=55
PROSPECT_MIN_TITLE_SCORE=45
PROSPECT_MIN_ORG_REVENUE=100000000
PROSPECT_BRAND_MIN_ORG_REVENUE=10000000
PROSPECT_MIN_ORG_EMPLOYEES=0
PROSPECT_RESEARCH_WORKERS=3
PROSPECT_USE_CURSOR_SCORING=true
PROSPECT_CURSOR_EMPLOYER_RESOLVE=
PROSPECT_SKIP_EMPLOYER_ENRICH=
BLACKLIST_FILE=data/inputs/blacklist.txt

# --- Concert Series volume path ---
CONCERT_MIN_ORG_REVENUE=10000000
CONCERT_MIN_ORG_EMPLOYEES=51
CONCERT_REQUIRE_SPEND_EVIDENCE=true
CONCERT_SPEND_BATCH_SIZE=8
CONCERT_SPEND_CONCURRENCY=3
CONCERT_SPEND_TAVILY_DEPTH=fast

# --- Research / Cursor / Tavily ---
CURSOR_RESEARCH_MODEL=composer-2.5
CURSOR_COMPOSER_FAST=false
CURSOR_CLOUD_CREATE_TIMEOUT=180
CURSOR_CLOUD_TIMEOUT=300
CURSOR_EMPLOYER_TIMEOUT=120
CURSOR_SCORING_BACKEND=auto
CURSOR_SCORE_BATCH_SIZE=6
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_ANSWER=advanced
TAVILY_MAX_RESULTS=8
# TAVILY_EXCLUDE_DOMAINS=
MIAMI_EVENTS_YEAR=2026
MIAMI_EVENTS_REGION=South Florida
MIAMI_EVENTS_TAVILY_QUERIES=8
RESEARCH_MAX_BRANDS_PER_EVENT=12
ADJACENT_MAX_BRANDS_PER_SEGMENT=12
ADJACENT_TAVILY_QUERIES=3
RESEARCH_EVENT_OFFSET=0

# Optional deck overrides (default: PDFs under data/)
# UNDERLINE_BRAND_DECK_PATH=
# UNDERLINE_LEVITT_DECK_PATH=

# Inspect New Leads
# SNAPSHOT_FILE=data/outputs/new_leads_snapshot.json
# SUMMARY_FILE=data/outputs/new_leads_summary.txt
